<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.csp-brain.health-watchdog</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/dkmac/.hermes/scripts/csp_health_watchdog.py</string>
    </array>
    
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    
    <key>StandardOutPath</key>
    <string>/Users/dkmac/csp-brain/_ops/logs/health-watchdog.log</string>
    
    <key>StandardErrorPath</key>
    <string>/Users/dkmac/csp-brain/_ops/logs/health-watchdog.err</string>
    
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
